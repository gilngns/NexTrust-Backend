# ============================================================
# NexTrust Backend — Environment Variables
# Salin ke .env dan isi. JANGAN commit .env asli!
# ============================================================

PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/nextrust?schema=public"

# --- Auth ---
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

# --- Enkripsi custodial wallet (WAJIB, string acak panjang) ---
# Dipakai mengenkripsi private key wallet user. JANGAN diubah setelah ada data.
WALLET_ENCRYPTION_SECRET=ganti-dengan-string-acak-sangat-panjang

# --- Blockchain ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ESCROW_ADDRESS=0xD566636AB5A74276B0c120bD4593f9547D601bC9
XIDR_ADDRESS=0x3C1a391628A6805E8158C6ed747b640812E97eb6
BACKEND_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=

# --- Midtrans (sandbox) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
