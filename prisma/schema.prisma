generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  name             String
  role             UserRole        @default(FOUNDATION)
  custodialAddress String?         @unique
  encryptedKey     String?
  skKemenkumham    String?
  izinPub          String?
  isVerified       Boolean         @default(false)
  bankName         String?
  bankAccountNo    String?
  bankHolder       String?
  phoneNumber      String?
  dateOfBirth      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  campaigns        Campaign[]
  notifications    Notification[]
  payouts          Payout[]
  refreshTokens    RefreshToken[]
  donorDonations   Donation[]      @relation("DonorDonations")
}

model Campaign {
  id              String            @id @default(cuid())
  onChainId       String            @unique
  title           String
  description     String?
  imageUrl        String?
  category        CampaignCategory?
  rabCID          String?
  latitude        Float?
  longitude       Float?
  izinPub         String?
  aiScore         Int?
  aiNotes         String?
  rabData         Json?
  targetAmount    BigInt
  advanceAmount   BigInt
  milestoneAmount BigInt
  totalMilestones Int
  status          CampaignStatus    @default(DRAFT)
  txHashCreate    String?
  foundationId    String
  beneficiary     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  foundation      User              @relation(fields: [foundationId], references: [id])
  donations       Donation[]
  milestones      Milestone[]
  payouts         Payout[]
  totalRaised     Decimal  @default(0) @db.Decimal(30, 0)
  donorCount      Int      @default(0)
  escrowBalance   Decimal  @default(0) @db.Decimal(30, 0)
  snapshotAt      DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([category, status])
}

model Donation {
  id            String         @id @default(cuid())
  campaignId    String
  donorId       String?
  donorName     String?
  donorAddress  String
  amount        BigInt
  status        DonationStatus @default(PENDING)
  orderId       String         @unique
  qrisUrl       String?
  paidAt        DateTime?
  txHashDeposit String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaign      Campaign       @relation(fields: [campaignId], references: [id])
  donor         User?          @relation("DonorDonations", fields: [donorId], references: [id])
}

model Milestone {
  id             String          @id @default(cuid())
  campaignId     String
  index          Int
  title          String?
  amount         BigInt?
  evidenceCID    String?
  evidenceUrl    String?
  evidenceUrl2   String?
  metadataHash   String?
  latitude       Float?
  longitude      Float?
  aiScore        Int?
  status         MilestoneStatus @default(PENDING)
  txHashSubmit   String?
  txHashOracle   String?
  txHashRelease  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  submitAttempts Int             @default(0)
  campaign       Campaign        @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, index])
}

model Payout {
  id            String       @id @default(cuid())
  campaignId    String
  foundationId  String
  amount        BigInt
  status        PayoutStatus @default(PENDING)
  bankName      String?
  bankAccountNo String?
  payoutRef     String?
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  campaign      Campaign     @relation(fields: [campaignId], references: [id])
  foundation    User         @relation(fields: [foundationId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model RabCheck {
  id              String   @id @default(cuid())
  campaignDraftId String?
  items           String
  totalAmount     BigInt
  targetAmount    BigInt
  score           Int
  reasonable      Boolean
  notes           String?
  createdAt       DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

enum UserRole {
  ADMIN
  FOUNDATION
  DINSOS
  DONOR
}

enum CampaignCategory {
  PEMBANGUNAN
  PENGADAAN_BARANG
  ALAT_KESEHATAN
  REKONSTRUKSI
}

enum CampaignStatus {
  DRAFT
  EVALUATING
  ACTIVE
  FUNDED
  VALIDATED
  ADVANCE_PAID
  MILESTONE_SUBMITTED
  FROZEN
  REJECTED
  COMPLETED
}

enum DonationStatus {
  PENDING
  PAID
  DEPOSITED
  FAILED
  EXPIRED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  EVALUATING
  APPROVED
  REJECTED
  RELEASED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  USER
}
